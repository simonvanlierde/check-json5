---
source: crates/jsonvet/tests/cases.rs
expression: "snapshot(&[(Json, r#\"{\"a\": 1, \"a\": 2}\"#),\n(Json,\n\"{\\n  \\\"x\\\": {\\\"a\\\": 1, \\\"\\\\u0061\\\": 2},\\n  \\\"l\\\": [{\\\"k\\\": 1}, {\\\"k\\\": 2, \\\"k\\\": 3}],\\n  \\\"x\\\": 0\\n}\"),\n(Json5, \"{a: 1, 'a': 2, \\\"b c\\\": {d: 1, d: 2}, \\\\u0061: 3}\"),\n(Json5, \"{\\\"ünicode\\\": 1, \\\"ünicode\\\": 2}\"), (IJson, r#\"{\"a\": 1, \"a\": 2}\"#),\n(Json, r#\"[{\"a\": 1, \"a\": 2}, {\"\\x\": 0}]\"#),])"
---
json "{\"a\": 1, \"a\": 2}"
       1:10 error[duplicate-key] duplicate key $.a (from 1:2)
json "{\n  \"x\": {\"a\": 1, \"\\u0061\": 2},\n  \"l\": [{\"k\": 1}, {\"k\": 2, \"k\": 3}],\n  \"x\": 0\n}"
       2:17 error[duplicate-key] duplicate key $.x.a (from 2:9)
       3:28 error[duplicate-key] duplicate key $.l[1].k (from 3:20)
       4:3 error[duplicate-key] duplicate key $.x (from 2:3)
json5 "{a: 1, 'a': 2, \"b c\": {d: 1, d: 2}, \\u0061: 3}"
       1:8 error[duplicate-key] duplicate key $.a (from 1:2)
       1:30 error[duplicate-key] duplicate key $["b c"].d (from 1:24)
       1:37 error[duplicate-key] duplicate key $.a (from 1:2)
json5 "{\"ünicode\": 1, \"ünicode\": 2}"
       1:16 error[duplicate-key] duplicate key $["\u00fcnicode"] (from 1:2)
i-json "{\"a\": 1, \"a\": 2}"
       1:10 error[duplicate-key] duplicate key $.a (from 1:2)
json "[{\"a\": 1, \"a\": 2}, {\"\\x\": 0}]"
       1:11 error[duplicate-key] duplicate key $[0].a (from 1:3)
       1:22 error[syntax] invalid escape `\x`
